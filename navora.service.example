[Unit]
Description=Navora FastAPI Backend Service
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Navora/backend
EnvironmentFile=/home/ubuntu/Navora/backend/.env
ExecStart=/home/ubuntu/Navora/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
