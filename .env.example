# =========================================================================
# NAVORA TRAVEL PLANNER - ENVIRONMENT VARIABLE TEMPLATE
# =========================================================================

# -------------------------------------------------------------------------
# BACKEND CONFIGURATION (Place in backend/.env)
# -------------------------------------------------------------------------
# Large Language Model integration (Groq API Key)
GROQ_API_KEY=your_groq_api_key_here

# Local search and attraction points API (Serper.dev API Key)
SERPER_API_KEY=your_serper_api_key_here

# Weather forecast API (OpenWeather API Key)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Movie database API (TMDB API Key for live theater recommendations)
TMDB_API_KEY=your_tmdb_api_key_here

# Database URL: Set to your MongoDB connection string (e.g. Atlas cluster).
# If left empty/undefined, the application automatically falls back to
# an in-memory database to allow immediate running.
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/navora

# Port for local backend (defaults to 8000)
PORT=8000


# -------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Place in frontend/.env)
# -------------------------------------------------------------------------
# Endpoint configuration mapping to the local backend API
VITE_API_URL=http://localhost:8000/api
